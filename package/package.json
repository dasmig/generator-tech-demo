{
  "name": "@dasmig/persona",
  "version": "1.0.0",
  "description": "Complete fictional characters (name, country, city, birth, body, personality, interests, job) from one seeded call, in WebAssembly.",
  "type": "module",
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "node": "./node.mjs",
      "default": "./index.mjs"
    },
    "./persona.wasm": "./persona.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "node.mjs",
    "generator.mjs",
    "pool-worker-core.mjs",
    "pool-worker-node.mjs",
    "pool-worker.mjs",
    "pool.mjs",
    "batch.mjs",
    "versions.mjs",
    "index.d.ts",
    "persona.mjs",
    "persona.wasm",
    "README.md",
    "LICENSE",
    "DATA_LICENSES.txt"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "procedural-generation",
    "character-generator",
    "persona",
    "names",
    "webassembly",
    "seeded"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dasmig/generator-tech-demo.git",
    "directory": "package"
  },
  "homepage": "https://github.com/dasmig/persona-generator",
  "bugs": {
    "url": "https://github.com/dasmig/generator-tech-demo/issues"
  },
  "author": "Diego Dasso Migotto",
  "license": "MIT"
}
